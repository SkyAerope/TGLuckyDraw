---

<script>
	const refreshButton = document.getElementById('refresh-button') as HTMLButtonElement;
  const messageElement = document.getElementById('message') as HTMLParagraphElement;
  const messageTimeElement = document.getElementById('messageTime') as HTMLParagraphElement;
  
  refreshButton.addEventListener('click', async () => {
    // 获取按钮的文本内容
    const buttonText = refreshButton.textContent;
    try {
      refreshButton.disabled = true;
      refreshButton.textContent = '抽卡中...';

      const response = await fetch('/api/random-message');
      const data = await response.json();

      if (data.message) {
        messageElement.textContent = data.message.randomMessage;
        messageTimeElement.textContent = new Date(data.message.messageTime * 1000).toLocaleString();
      } else {
        messageElement.textContent = '无法获取消息，请稍后重试。';
      }
    } catch (error) {
      messageElement.textContent = '请求失败，请稍后重试。';
    } finally {
      refreshButton.disabled = false;
      refreshButton.textContent = buttonText;
    }
  });
</script>

<div>
  <!-- <p id="message">{defaultMessage}</p> -->
  <mdui-button full-width id="refresh-button">
    <slot>
      抽卡一次
    </slot>
  </mdui-button>
</div>

<style>
  mdui-button {
    margin-top: 16px;
  }
</style>