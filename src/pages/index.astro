---
import RefreshButton from '../components/RefreshButton.astro';
const initialMessage = '正在加载消息…';
const messageTime = '';
---
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no"/>
  <meta name="renderer" content="webkit"/>
  <meta name="force-rendering" content="webkit"/>
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <link rel="icon" type="image/x-icon" href="favicon.svg">

  <style>
    .message-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    #copy-message {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 40px;
      width: 40px;
      height: 40px;
      padding: 8px;
      border: 0;
      border-radius: 50%;
      color: inherit;
      background: transparent;
      cursor: pointer;
    }
    #copy-message:hover { background: rgba(128, 128, 128, 0.12); }
    #copy-message:focus-visible { outline: 2px solid currentColor; }
    #copy-message:disabled { opacity: 0.38; cursor: default; }
    #copy-status { font-size: 12px; text-align: right; }
    #copy-status:empty { display: none; }
    #message {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .container,.container-fluid{-webkit-box-sizing:border-box;box-sizing:border-box;margin-right:auto;margin-left:auto;padding-right:8px;padding-left:8px}.container-fluid::after,.container::after{display:table;clear:both;content:''}.container{width:96%;max-width:1280px}
    @media (min-width:600px){.container{width:94%}}
    @media (min-width:1024px){.container{width:92%}}
    .card-content{position:relative;padding:16px;font-size:14px;line-height:24px}
    .card-primary-title{display:block;font-size:24px;line-height:36px;opacity:.87}
    .card-primary-subtitle{display:block;font-size:14px;line-height:24px;opacity:.54}
    .typo-display-4,.typo-display-4-opacity{font-weight:300;font-size:112px;letter-spacing:-.04em}.typo-display-4-opacity{opacity:.54}
    .text-center{text-align:center!important}
    .center{display:block!important;margin-right:auto!important;margin-left:auto!important}

  </style>
  <!-- MDUI CSS -->
  <link rel="stylesheet" href="https://unpkg.com/mdui@2.0.3/mdui.css">
  <!-- <link rel="stylesheet" href="https://unpkg.com/mdui@1.0.2/dist/css/mdui.min.css"> -->
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link rel="stylesheet" href="./font.css">
  <title>随机消息</title>
  <!-- MDUI JavaScript -->
  <script src="https://unpkg.com/mdui@2.0.3/mdui.global.js"></script>
</head>
<body class="container">
  <mdui-top-app-bar>
    <mdui-top-app-bar-title>随机消息</mdui-top-app-bar-title>
    <div style="flex-grow: 1"></div>
    <mdui-tooltip content="查看 Github">
        <mdui-button-icon>
          <a href="https://github.com/SkyAerope/TGLuckyDraw" target="_blank">
            <svg version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 36 36" enable-background="new 0 0 36 36" xml:space="preserve" style="width: 24px;height:24px;">
              <path fill-rule="evenodd" clip-rule="evenodd" fill="#212121" d="M18,1.4C9,1.4,1.7,8.7,1.7,17.7c0,7.2,4.7,13.3,11.1,15.5c0.8,0.1,1.1-0.4,1.1-0.8c0-0.4,0-1.4,0-2.8c-4.5,1-5.5-2.2-5.5-2.2c-0.7-1.9-1.8-2.4-1.8-2.4c-1.5-1,0.1-1,0.1-1c1.6,0.1,2.5,1.7,2.5,1.7c1.5,2.5,3.8,1.8,4.7,1.4c0.1-1.1,0.6-1.8,1-2.2c-3.6-0.4-7.4-1.8-7.4-8.1c0-1.8,0.6-3.2,1.7-4.4c-0.2-0.4-0.7-2.1,0.2-4.3c0,0,1.4-0.4,4.5,1.7c1.3-0.4,2.7-0.5,4.1-0.5c1.4,0,2.8,0.2,4.1,0.5c3.1-2.1,4.5-1.7,4.5-1.7c0.9,2.2,0.3,3.9,0.2,4.3c1,1.1,1.7,2.6,1.7,4.4c0,6.3-3.8,7.6-7.4,8c0.6,0.5,1.1,1.5,1.1,3c0,2.2,0,3.9,0,4.5c0,0.4,0.3,0.9,1.1,0.8c6.5-2.2,11.1-8.3,11.1-15.5C34.3,8.7,27,1.4,18,1.4z"></path>
            </svg>
          </a>
        </mdui-button-icon>
    </mdui-tooltip>
  </mdui-top-app-bar>
  <p></p>

  <mdui-card class="center">
    <div class="card-content mdui-prose">
      <div class="message-header">
        <div class="card-primary-title">消息内容</div>
        <button id="copy-message" type="button" aria-label="复制消息" title="复制消息" disabled>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="8" y="8" width="12" height="13" rx="2"></rect>
            <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"></path>
          </svg>
        </button>
      </div>
      <div id="copy-status" role="status" aria-live="polite"></div>
      <div id="messageTime" class="card-primary-subtitle">{messageTime}</div>
    <p role="status" aria-live="polite" id="message" class="text-center">{initialMessage}</p>
  </div>
  </mdui-card>

    <script>
      const copyButton = document.getElementById('copy-message') as HTMLButtonElement;
      const message = document.getElementById('message') as HTMLElement;
      const time = document.getElementById('messageTime') as HTMLElement;
      const status = document.getElementById('copy-status') as HTMLElement;
      let feedbackTimer: ReturnType<typeof setTimeout> | undefined;

      new MutationObserver(() => {
        copyButton.disabled = !time.textContent?.trim();
        status.textContent = '';
        clearTimeout(feedbackTimer);
      }).observe(time, { childList: true, subtree: true, characterData: true });

      copyButton.addEventListener('click', async () => {
        if (copyButton.disabled) return;
        try {
          await navigator.clipboard.writeText(message.textContent || '');
          status.textContent = '已复制';
        } catch {
          status.textContent = '复制失败，请长按或选中文字复制';
        }
        clearTimeout(feedbackTimer);
        feedbackTimer = setTimeout(() => { status.textContent = ''; }, 3000);
      });
    </script>

    <main>
      <RefreshButton>
        抽卡一次
      </RefreshButton>
      <!-- <RefreshButton>
        连抽五次
      </RefreshButton> -->
    </main>
  </body>
</html>
